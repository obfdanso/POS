# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/pos_db"

# JWT Secrets (use 256-bit random strings - generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_ACCESS_SECRET="replace-with-256-bit-random-string"
JWT_REFRESH_SECRET="replace-with-different-256-bit-random-string"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV="development"

# CORS - Frontend origin
CORS_ORIGIN="http://localhost:5173"

# Store Configuration (used in receipts)
STORE_NAME="QuickMart POS"
STORE_ADDRESS="27 Kwame Nkrumah Ave, Kumasi, Ghana"
STORE_PHONE="032-204-1234"

# Tax & Loyalty
TAX_RATE=0
LOYALTY_POINTS_RATE=10

# Cookie
COOKIE_DOMAIN="localhost"

# Paystack
PAYSTACK_SECRET_KEY="secret key goes here"
PAYSTACK_PUBLIC_KEY="public key goes here"