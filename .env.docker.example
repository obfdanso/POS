# Settings for `docker compose up`. Copy to .env in this folder and fill in real values.
# Never commit .env.

# Database password. Use letters and digits only: it goes inside the connection URL.
POSTGRES_PASSWORD=change-me

# Two different 256-bit random strings, generated with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Port the app is served on: http://localhost:8080
APP_PORT=8080

# Set to false only if devices reach the app over plain HTTP on the shop's private network
# (e.g. http://192.168.1.20:8080). localhost works without it.
COOKIE_SECURE=

# Optional: Paystack keys for card and mobile money payments (test keys start with sk_test_ / pk_test_)
PAYSTACK_SECRET_KEY=
VITE_PAYSTACK_PUBLIC_KEY=

# Optional: emailed receipts through any SMTP provider (leave SMTP_HOST empty to turn them off)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Optional: texted receipts through arkesel or twilio (leave SMS_PROVIDER empty to turn them off)
SMS_PROVIDER=
ARKESEL_API_KEY=
SMS_SENDER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Optional: Sentry error reporting (create a Node and a React project at sentry.io)
SENTRY_DSN=
VITE_SENTRY_DSN=
