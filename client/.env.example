# Copy to .env.local (ignored by git) and fill in.

# Paystack public key for the card / mobile money popup (pk_test_... for testing).
# Must belong to the same Paystack account as PAYSTACK_SECRET_KEY in server/.env.
VITE_PAYSTACK_PUBLIC_KEY=""

# Optional: report browser crashes to Sentry. Leave empty to turn it off (the Sentry code is then never downloaded).
VITE_SENTRY_DSN=""
