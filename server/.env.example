# Copy to .env and fill in real values. Never commit .env.
# Store name, address, phone, tax rate, loyalty rate, and currency are set in the app's Settings page.

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/pos_db"

# JWT secrets — use two different 256-bit random strings, generated with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="replace-with-256-bit-random-string"
JWT_REFRESH_SECRET="replace-with-different-256-bit-random-string"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV="development"

# Refresh cookies are HTTPS-only when NODE_ENV=production. Set COOKIE_SECURE=false only to run over
# plain HTTP on a private network (e.g. shop tablets reaching http://192.168.x.x); never on the internet.
# COOKIE_SECURE=false

# Frontend origin allowed by CORS (the Vite dev server by default)
CORS_ORIGIN="http://localhost:5173"

# Set to 1 when running behind one reverse proxy (nginx, Caddy) so client IPs are seen correctly.
# Leave unset when Express is reached directly.
# TRUST_PROXY=1

# Paystack secret key, used to verify card and mobile money payments server-side.
# Use a test key (sk_test_...) from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=""
# Card / Mobile Money refunds are sent back through Paystack automatically; false records them only
# PAYSTACK_AUTO_REFUND=true

# Optional: emailed receipts. Leave SMTP_HOST empty to turn them off (the Email button then explains
# that email isn't set up). Works with any SMTP provider, e.g. Gmail with an app password,
# Mailgun, SendGrid, Brevo, or Amazon SES.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false        # true for port 465
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="QuickMart <receipts@example.com>"

# Optional: texted receipts. Leave SMS_PROVIDER empty to turn them off. Use arkesel (Ghana) or
# twilio. Local numbers like 024-123-4567 get SMS_COUNTRY_CODE (default 233).
# SMS_PROVIDER=arkesel
# ARKESEL_API_KEY=
# SMS_SENDER_ID=QuickMart   # up to 11 characters, registered with Arkesel
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+15005550006
# SMS_COUNTRY_CODE=233
# Texts cost money, so only numbers in SMS_COUNTRY_CODE are allowed unless listed here, e.g. 233,234
# SMS_ALLOWED_COUNTRY_CODES=

# Optional: report unexpected server errors to Sentry (https://sentry.io). Leave empty to turn it off.
# Only errors are sent, tagged with the request ID; tokens, cookies and request bodies are stripped.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
