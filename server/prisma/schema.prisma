generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  CASHIER
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  CARD
  // A sale paid partly one way and partly another; its Payment rows hold the actual methods
  SPLIT
}

// A refund sent back through Paystack: not sent yet (or to be done in the dashboard), then
// Paystack's own states
enum GatewayRefundStatus {
  NOT_SENT
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum PaymentStatus {
  COMPLETED
  PARTIALLY_REFUNDED
  REFUNDED
  PENDING
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum InventoryChangeType {
  SALE
  RESTOCK
  ADJUSTMENT
  RETURN
}

model User {
  id                    String    @id @default(uuid())
  username              String    @unique
  email                 String    @unique
  password_hash         String
  full_name             String
  role                  Role      @default(CASHIER)
  is_active             Boolean   @default(true)
  failed_login_attempts Int       @default(0)
  locked_until          DateTime?
  // Sessions (access/refresh tokens) issued before this moment are rejected, e.g. after a password change
  tokens_valid_after    DateTime?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  sales           Sale[]
  inventory_logs  InventoryLog[]
  auth_logs       AuthLog[]
  audit_logs      AuditLog[]
  shifts          Shift[]         @relation("ShiftCashier")
  closed_shifts   Shift[]         @relation("ShiftClosedBy")
  refunds         Refund[]
  purchase_orders PurchaseOrder[]
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  products   Product[]
  promotions Promotion[]
}

model Supplier {
  id         String   @id @default(uuid())
  name       String   @unique
  phone      String?
  email      String?
  address    String?
  website    String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  products        Product[]
  purchase_orders PurchaseOrder[]
}

model Product {
  id                  String   @id @default(uuid())
  name                String
  sku                 String   @unique
  barcode             String?  @unique
  category_id         String
  supplier_id         String?
  price               Decimal  @db.Decimal(10, 2)
  cost_price          Decimal? @db.Decimal(10, 2)
  quantity            Int      @default(0)
  low_stock_threshold Int      @default(10)
  image_url           String?
  is_active           Boolean  @default(true)
  // Variants (sizes, flavours) are products of their own, with their own SKU, price and stock,
  // grouped under a main product. Only one level: a variant can't have variants
  parent_id           String?
  // The option's label, e.g. "1.5L"; required for variants, optional for the main product
  variant_name        String?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  category             Category            @relation(fields: [category_id], references: [id])
  supplier             Supplier?           @relation(fields: [supplier_id], references: [id])
  parent               Product?            @relation("ProductVariants", fields: [parent_id], references: [id], onDelete: Restrict)
  variants             Product[]           @relation("ProductVariants")
  sale_items           SaleItem[]
  inventory_logs       InventoryLog[]
  purchase_order_items PurchaseOrderItem[]
  promotions           Promotion[]

  @@unique([parent_id, variant_name])
  @@index([parent_id])
  @@index([barcode])
  @@index([sku])
}

model Customer {
  id             String   @id @default(uuid())
  name           String
  phone          String?  @unique
  email          String?  @unique
  address        String?
  loyalty_points Int      @default(0)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  sales Sale[]

  @@index([phone])
}

model Sale {
  id                      String        @id @default(uuid())
  transaction_id          String        @unique
  user_id                 String
  customer_id             String?
  subtotal                Decimal       @db.Decimal(10, 2)
  discount_amount         Decimal       @default(0) @db.Decimal(10, 2)
  tax_amount              Decimal       @default(0) @db.Decimal(10, 2)
  total_amount            Decimal       @db.Decimal(10, 2)
  payment_method          PaymentMethod
  payment_status          PaymentStatus @default(COMPLETED)
  notes                   String?
  // Points awarded for this sale, so a refund reverses exactly what was given
  loyalty_points_earned   Int           @default(0)
  // Running totals of returns against this sale; reports subtract them
  refunded_amount         Decimal       @default(0) @db.Decimal(10, 2)
  loyalty_points_reversed Int           @default(0)
  // Points spent on this sale; their value (points_discount) is included in discount_amount
  loyalty_points_redeemed Int           @default(0)
  points_discount         Decimal       @default(0) @db.Decimal(10, 2)
  // Redeemed points given back by returns so far
  loyalty_points_restored Int           @default(0)
  created_at              DateTime      @default(now())
  updated_at              DateTime      @updatedAt

  // The cash drawer shift the sale was rung up in
  shift_id String?

  user       User       @relation(fields: [user_id], references: [id])
  customer   Customer?  @relation(fields: [customer_id], references: [id], onDelete: SetNull)
  shift      Shift?     @relation(fields: [shift_id], references: [id], onDelete: SetNull)
  sale_items SaleItem[]
  payments   Payment[]
  refunds    Refund[]

  @@index([transaction_id])
  @@index([created_at])
  @@index([shift_id])
}

// A cashier's session at the till: opened with a cash float, closed by counting the drawer.
// At most one OPEN shift per cashier (partial unique index in the migration).
model Shift {
  id            String      @id @default(uuid())
  user_id       String
  status        ShiftStatus @default(OPEN)
  opening_float Decimal     @db.Decimal(10, 2)
  // Set when the shift closes: what the drawer should hold, what was counted, and counted − expected
  expected_cash Decimal?    @db.Decimal(10, 2)
  counted_cash  Decimal?    @db.Decimal(10, 2)
  difference    Decimal?    @db.Decimal(10, 2)
  opened_at     DateTime    @default(now())
  closed_at     DateTime?
  closed_by_id  String?
  notes         String?
  created_at    DateTime    @default(now())
  updated_at    DateTime    @updatedAt

  user      User     @relation("ShiftCashier", fields: [user_id], references: [id])
  closed_by User?    @relation("ShiftClosedBy", fields: [closed_by_id], references: [id])
  sales     Sale[]
  refunds   Refund[]

  @@index([user_id, status])
  @@index([opened_at])
}

model SaleItem {
  id                 String   @id @default(uuid())
  sale_id            String
  product_id         String
  quantity           Int
  unit_price         Decimal  @db.Decimal(10, 2)
  // Cost price at the time of sale, so profit reports aren't rewritten when costs change
  unit_cost          Decimal? @db.Decimal(10, 2)
  // All money off this line: the promotion's share plus any discount the cashier added
  discount           Decimal  @default(0) @db.Decimal(10, 2)
  total              Decimal  @db.Decimal(10, 2)
  // Units returned so far (never more than quantity)
  refunded_quantity  Int      @default(0)
  // The promotion applied automatically, and its part of `discount`
  promotion_id       String?
  promotion_discount Decimal  @default(0) @db.Decimal(10, 2)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  sale         Sale         @relation(fields: [sale_id], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [product_id], references: [id], onDelete: Restrict)
  promotion    Promotion?   @relation(fields: [promotion_id], references: [id], onDelete: SetNull)
  refund_items RefundItem[]
}

// One return against a sale: some or all of its items, paid back by the sale's payment method
model Refund {
  id                String               @id @default(uuid())
  sale_id           String
  user_id           String
  // The refunding user's open shift; cash refunds come out of that drawer
  shift_id          String?
  amount            Decimal              @db.Decimal(10, 2)
  method            PaymentMethod
  // The part paid back in cash from the drawer (all of a cash refund; split sales refund cash first)
  cash_amount       Decimal              @default(0) @db.Decimal(10, 2)
  reason            String
  // The card / Mobile Money part sent back through Paystack's refund API, and how that is going.
  // Null status: nothing to send (a cash refund)
  gateway_status    GatewayRefundStatus?
  gateway_amount    Decimal?             @db.Decimal(10, 2)
  gateway_reference String?
  gateway_refund_id String?              @unique
  gateway_error     String?
  created_at        DateTime             @default(now())
  updated_at        DateTime             @updatedAt

  sale  Sale         @relation(fields: [sale_id], references: [id], onDelete: Cascade)
  user  User         @relation(fields: [user_id], references: [id])
  shift Shift?       @relation(fields: [shift_id], references: [id], onDelete: SetNull)
  items RefundItem[]

  @@index([sale_id])
  @@index([shift_id])
  @@index([created_at])
}

model RefundItem {
  id           String   @id @default(uuid())
  refund_id    String
  sale_item_id String
  quantity     Int
  amount       Decimal  @db.Decimal(10, 2)
  // false when the goods were damaged and not put back on the shelf
  restocked    Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  refund    Refund   @relation(fields: [refund_id], references: [id], onDelete: Cascade)
  sale_item SaleItem @relation(fields: [sale_item_id], references: [id], onDelete: Cascade)

  @@index([sale_item_id])
}

model Payment {
  id           String        @id @default(uuid())
  sale_id      String
  method       PaymentMethod
  amount_paid  Decimal       @db.Decimal(10, 2)
  change_given Decimal       @default(0) @db.Decimal(10, 2)
  reference    String?       @unique // a Paystack reference can pay for only one sale
  created_at   DateTime      @default(now())
  updated_at   DateTime      @updatedAt

  sale Sale @relation(fields: [sale_id], references: [id], onDelete: Cascade)
}

model InventoryLog {
  id                String              @id @default(uuid())
  product_id        String
  change_type       InventoryChangeType
  quantity_change   Int
  previous_quantity Int
  new_quantity      Int
  user_id           String
  notes             String?
  created_at        DateTime            @default(now())
  updated_at        DateTime            @updatedAt

  product Product @relation(fields: [product_id], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [user_id], references: [id])
}

// Refresh tokens that were logged out or rotated, kept until they would have expired anyway.
// Stored in the database so revocation survives restarts and works across server instances.
model RevokedToken {
  jti        String   @id
  expires_at DateTime
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([expires_at])
}

model AuthLog {
  id         String   @id @default(uuid())
  user_id    String?
  event_type String
  ip_address String?
  user_agent String?
  details    String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)
}

model Settings {
  id         String   @id @default(uuid())
  key        String   @unique
  value      String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

// Who did what for destructive or sensitive operations (deactivations, deletions, refunds, settings, user changes)
model AuditLog {
  id         String   @id @default(uuid())
  user_id    String?
  action     String
  entity     String
  entity_id  String?
  details    String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([entity, entity_id])
  @@index([created_at])
}

enum PurchaseOrderStatus {
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

// Stock ordered from a supplier. Receiving goods (all at once or over several deliveries) adds them to stock
model PurchaseOrder {
  id            String              @id @default(uuid())
  po_number     String              @unique
  supplier_id   String
  created_by_id String
  status        PurchaseOrderStatus @default(ORDERED)
  // Sum of quantity ordered × unit cost
  total_cost    Decimal             @db.Decimal(12, 2)
  expected_at   DateTime?
  received_at   DateTime?
  notes         String?
  created_at    DateTime            @default(now())
  updated_at    DateTime            @updatedAt

  supplier   Supplier            @relation(fields: [supplier_id], references: [id], onDelete: Restrict)
  created_by User                @relation(fields: [created_by_id], references: [id])
  items      PurchaseOrderItem[]

  @@index([supplier_id])
  @@index([status])
  @@index([created_at])
}

model PurchaseOrderItem {
  id                String   @id @default(uuid())
  purchase_order_id String
  product_id        String
  quantity_ordered  Int
  quantity_received Int      @default(0)
  unit_cost         Decimal  @db.Decimal(10, 2)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  purchase_order PurchaseOrder @relation(fields: [purchase_order_id], references: [id], onDelete: Cascade)
  product        Product       @relation(fields: [product_id], references: [id], onDelete: Restrict)

  @@unique([purchase_order_id, product_id])
}

// An automatic percentage off one product, every product in a category, or (neither set) the whole
// store, between starts_at and ends_at. When several apply to a line, the biggest one wins
model Promotion {
  id          String    @id @default(uuid())
  name        String
  percent_off Decimal   @db.Decimal(5, 2)
  product_id  String?
  category_id String?
  starts_at   DateTime  @default(now())
  ends_at     DateTime?
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  product    Product?   @relation(fields: [product_id], references: [id], onDelete: Cascade)
  category   Category?  @relation(fields: [category_id], references: [id], onDelete: Cascade)
  sale_items SaleItem[]

  @@index([is_active, starts_at])
}
